# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). `.env` is gitignored.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Supabase calls the client-side key "publishable" (it looks like
# sb_publishable_...); older projects call the same thing the "anon" key. It is
# safe to ship — row level security is what protects the data.
# Never put a secret key (sb_secret_...) in here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
