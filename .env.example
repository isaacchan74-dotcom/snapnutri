# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). `.env` is gitignored.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# The anon key is safe to ship — row level security is what protects the data.
# Never put the service_role key in here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
