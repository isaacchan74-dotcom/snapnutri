# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). `.env` is gitignored.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Supabase calls the client-side key "publishable" (sb_publishable_…).
# Never put a secret key (sb_secret_...) in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
